{
  "name": "reliqarts/laravel-guided-image",
  "description": "Simplified and ready image manipulation for Laravel via intervention image.",
  "keywords": [
    "image",
    "route",
    "generation",
    "laravel",
    "photo",
    "laravel5",
    "resize",
    "thumb",
    "dummy",
    "crop"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "reliq",
      "email": "reliq@reliqarts.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.1 || ^12.1",
    "intervention/image": "^3.7",
    "reliqarts/laravel-common": "^8.0",
    "ext-json": "*",
    "ext-fileinfo": "*"
  },
  "require-dev": {
    "laravel/pint": "^1.15",
    "orchestra/testbench": "^9.0 || ^10.0",
    "phpro/grumphp": "^2.5",
    "phpspec/prophecy-phpunit": "^2.0",
    "phpunit/phpunit": "^11.0",
    "yieldstudio/grumphp-laravel-pint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "ReliqArts\\GuidedImage\\": "src/",
      "ReliqArts\\GuidedImage\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:ci": "phpunit --colors=auto --coverage-clover=build/coverage.xml",
    "test:unit": "phpunit --testsuite=Unit --verbose --coverage-clover=build/coverage.xml"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpro/grumphp": true
    }
  },
  "policy": {
    "advisories": {
      "ignore-id": [
        "PKSA-mdq4-51ck-6kdq",
        "PKSA-8qx3-n5y5-vvnd",
        "PKSA-q46n-4fdk-zjr4",
        "PKSA-qzrn-rnz3-85w1",
        "PKSA-w7xr-vk7n-rstm"
      ]
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ReliqArts\\GuidedImage\\ServiceProvider"
      ]
    }
  }
}
